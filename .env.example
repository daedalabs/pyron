# =========================================================
# TransEngine: Bring-Your-Own-AI (BYOAI) configuration
# =========================================================

# Option 1: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Option 2: OpenAI (or OpenRouter / Groq / DeepSeek / Local Ollama)
OPENAI_API_KEY=your_openai_or_groq_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Option 3: Local Ollama (100% offline, no API key needed)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3:8b

# Default provider when --ai is not passed (gemini, openai, or mock)
TRANS_DEFAULT_AI=gemini
